TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHANNEL_ID="your-channel-id"
TELEGRAM_THREAD_ID="your-thread-id"
TELEGRAM_GROUP_CHAT_ID="your-group-chat-id"

# News content language for Telegram posts: "en" (English) or "km" (Khmer).
# Everything else — badges, buttons, headers, command replies — matches the
# English bot exactly; only the headline/summary/key points are translated.
# Run two deployments of this codebase to get one bot per language —
# each service sets its own NEWS_LANGUAGE, TELEGRAM_BOT_TOKEN, and TELEGRAM_CHANNEL_ID.
# The English bot (NEWS_LANGUAGE=en) publishes every post to a shared Redis
# queue; the Khmer bot (NEWS_LANGUAGE=km) mirrors them in Khmer. Both services
# must point at the SAME REDIS_URL for mirroring to work.
NEWS_LANGUAGE=en

# Optional — enables persistent state on Railway/Render (get free URL at upstash.com)
# Also required as the shared queue that lets the Khmer bot mirror the English bot.
REDIS_URL="redis://default:your-password@your-host.upstash.io:6379"

# Polling interval (seconds between feed checks for non-digest paths; digest uses schedule hours)
POLL_INTERVAL_SECONDS=7200

# Digest schedule (hour of day in Asia/Phnom_Penh timezone)
DIGEST_SCHEDULE_HOUR_AM=5
DIGEST_SCHEDULE_HOUR_PM=17
DONATION_SCHEDULE_HOUR=22

# Feed / clustering tuning (defaults shown)
BOT_MAX_FEEDS=130
# MAX_ITEMS_PER_FEED=3
# MAX_ENTRY_AGE_HOURS=24
# FEED_TIMEOUT_SECONDS=10
# FEED_GLOBAL_TIMEOUT_EXTRA=50
# CLUSTER_SIMILARITY_THRESHOLD=0.45
# CLUSTER_TITLE_WEIGHT=0.7
# CLUSTER_SUMMARY_WEIGHT=0.3
# CONTENT_DEDUP_THRESHOLD=0.65

# Pipeline / AI timeouts
# PREPARE_ENTRIES_TIMEOUT_SECONDS=300
# AI_HTTP_TIMEOUT_SECONDS=30

# Spam heuristics (defaults: enabled; non-Latin script block on)
# SPAM_FILTER_ENABLED=true
# SPAM_BLOCK_NON_LATIN_SCRIPTS=true

# Optional copy overrides (empty DONATION_TEXT keeps the built-in default)
# DONATION_TEXT=
# DIGEST_HEADER_TEXT=📰 <b>Inbound Reports</b>

# Public website base URL — Telegram CTAs link here instead of raw sources.
# Digests open /brief/YYYY-MM-DD; individual stories open /story/{id} when publish works.
# WEBSITE_BASE_URL=https://inbound-news-web.vercel.app

# Supabase — optional for the Telegram worker; required for website ingestion pipeline.
# When set on the bot, Telegram digests also publish/attach stories so deep links work.
# Run supabase/migrations/001_ingestion_schema.sql through 007_story_sources_article_unique.sql.
# SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Website ingestion workers (optional for Telegram; required for site stories) ---
# COHERE_API_KEY=          # embeddings for workers.dedup (Jaccard fallback if unset)
# NEWSDATA_API_KEY=        # newsdata.io
# EXA_API_KEY=
# FIRECRAWL_API_KEY=
# CURRENTS_API_KEY=
# SKIP_AI_REWRITE=1        # skip Groq rewrite during ingest (faster first fill)
# MAX_AI_REWRITE=50        # cap AI rewrites per ingest run (default 50)

# --- AI Provider Keys (comma-separated for rotation) ---
# Create multiple keys per provider for 3x free-tier capacity.
# The router round-robins through them and marks rate-limited keys
# for a 60-second cooldown before retrying.
# Chain: Groq → OpenRouter → Gemini
# Future: DEEPSEEK_API_KEY=... (paid tier — not wired yet)

# Groq: primary AI — get keys at console.groq.com
GROQ_API_KEY="key1,key2,key3"

# Gemini: fallback AI — get keys at aistudio.google.com/apikey
GOOGLE_GEMINI_API_KEY="key1,key2,key3"

# OpenRouter: free-tier fallback — get keys at openrouter.ai/keys
# NOTE: Free model lineup rotates; check https://openrouter.ai/models
OPENROUTER_API_KEY="sk-or-v1-key1,sk-or-v1-key2,sk-or-v1-key3"

# Optional — override which free model to use
# OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# Donation message — QR image path (default: qr_aba_news.jpg in project root)
DONATION_QR_IMAGE="qr_aba_news.jpg"
