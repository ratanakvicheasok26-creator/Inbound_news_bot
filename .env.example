TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
GROQ_API_KEY="your-groq-api-key"
GOOGLE_GEMINI_API_KEY="your-gemini-api-key"

# Last-resort AI fallback (free tier) — used only if both Groq and
# Gemini fail/rate-limit. Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY="your-openrouter-api-key"
# Optional — override which free model to use. OpenRouter's free lineup
# rotates over time; check https://openrouter.ai/models (filter: Free)
# if the default below ever stops working.
# OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

TELEGRAM_CHANNEL_ID="your-channel-id"
TELEGRAM_THREAD_ID="your-thread-id"
TELEGRAM_GROUP_CHAT_ID="your-group-chat-id"

# Donation message — QR image path (default: qr_aba_news.jpg in project root)
DONATION_QR_IMAGE="qr_aba_news.jpg"

# Optional — enables persistent state on Railway/Render (get free URL at upstash.com)
REDIS_URL="redis://default:your-password@your-host.upstash.io:6379"

# Polling interval (seconds between feed checks)
POLL_INTERVAL_SECONDS=1200

# Supabase — bot writes each posted story here for the website to read
SUPABASE_URL="https://woldqxujzbxdhaopolme.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

#openrouter key
OPENROUTER_API_KEY="your-openrouter-api-key"
