# Inbound Reports web app (Vercel) — .env.example
# Copy to .env locally; set the same values in Vercel → Project → Settings → Env Vars.
# NEVER put SUPABASE_SERVICE_ROLE_KEY, TELEGRAM_BOT_TOKEN, or REDIS_URL here.

# Supabase public client (safe for browser — anon key only).
# Find both in Supabase Dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local demo stories when Supabase is unset (dev only).
# Production never auto-mocks; set USE_MOCK_STORIES=1 only to force demos.
# USE_MOCK_STORIES=1

# Server-only AI key for /api/local-lens (Local Lens paragraphs).
# Comma-separate multiple Groq keys to rotate: "key1,key2".
GROQ_API_KEYS=
GROQ_API_KEY=

# Server-only key for /api/websearch (Live web search on the search page).
# Get a free key at exa.ai — free tier includes ~1,000 searches/month.
EXA_API_KEY=


# Khmer Tlg 
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=