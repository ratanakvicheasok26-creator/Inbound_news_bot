# Inbound Reports web app (Vercel) — .env.example
# Copy to .env locally; set the same values in Vercel → Project → Settings → Env Vars.
# NEVER put SUPABASE_SERVICE_ROLE_KEY, TELEGRAM_BOT_TOKEN, or REDIS_URL here.

# Supabase public client (safe for browser — anon key only).
# Find both in Supabase Dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only AI key for /api/local-lens (Local Lens paragraphs).
# Comma-separate multiple Groq keys to rotate: "key1,key2".
GROQ_API_KEYS=
GROQ_API_KEY=
