# Inbound Reports web app (Vercel) — .env.example
# Copy to .env locally; set the same values in Vercel → Project → Settings → Env Vars.
# NEVER put SUPABASE_SERVICE_ROLE_KEY, TELEGRAM_BOT_TOKEN, or REDIS_URL here.

# Supabase public client (safe for browser — anon key only).
# Find both in Supabase Dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Stripe webhook writes to memberships via the service role —
# set this in Vercel env (NEVER in the browser). Find it in Supabase → Settings → API.
SUPABASE_SERVICE_ROLE_KEY=

# Authentication — JWT signing secret (server-only, NEVER expose to browser).
# Generate with: openssl rand -base64 64
JWT_SECRET=
# JWT audience and issuer (optional, have defaults).
# JWT_AUDIENCE=inbound-news-api
# JWT_ISSUER=inbound-news-auth

# Public site URL — used for email verification links and redirect URIs.
NEXT_PUBLIC_SITE_URL=https://inboundnews.example.com

# Membership (Stripe) — set these in Vercel env to enable /pricing + checkout.
# Get keys at dashboard.stripe.com (test mode while developing).
# 1) STRIPE_SECRET_KEY from API keys
# 2) Create two recurring prices: Monthly $6.99 and Annual $59.99, then copy their ids.
# 3) STRIPE_WEBHOOK_SECRET from dashboard → Webhooks (endpoint: <site>/api/stripe/webhook)
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_WEBHOOK_SECRET=

# Membership payment QR codes (shown in the /pricing modal and payment dialog).
# Defaults are files at public/khqr7_9.png and public/khqr49_99.png — regenerate
# them as ABA/KHQR for $6.99 (monthly) and $59.99 (annual), or override with
# hosted image URLs here.
# NEXT_PUBLIC_MEMBERSHIP_QR_PRO_URL=
# NEXT_PUBLIC_MEMBERSHIP_QR_PREMIUM_URL=

# Admin QR-payment review: comma-separated emails allowed to open /admin/qr and
# approve/reject ABA transaction submissions. Must match a signed-in account.
ADMIN_EMAILS=

# Local demo stories when Supabase is unset (dev only).
# Production never auto-mocks; set USE_MOCK_STORIES=1 only to force demos.
# USE_MOCK_STORIES=1

# Server-only AI keys for /api/local-lens (Local Lens paragraphs) and the
# Khmer Decode pipeline (src/lib/khmer-content.ts).
# Comma-separate multiple Groq keys to rotate: "key1,key2".
GROQ_API_KEYS=
GROQ_API_KEY=

# Khmer Decode prefers Gemini (far better at Khmer script), Groq is the
# fallback. Get a key at aistudio.google.com/apikey. Default model is the
# rolling alias "gemini-flash-latest" (override with GEMINI_MODEL).
# GOOGLE_GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Server-only key for /api/websearch (Live web search on the search page).
# Get a free key at exa.ai — free tier includes ~1,000 searches/month.
EXA_API_KEY=


# Khmer Tlg 
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Ads — rotating poster creatives (src/lib/sponsors.ts mocks; Supabase when configured).
# Hide all ad bands: NEXT_PUBLIC_ADS_MOCK=0
# Telegram /ad_* admin writes to sponsors table (migration 008_sponsors.sql).
# NEXT_PUBLIC_ADS_MOCK=0
